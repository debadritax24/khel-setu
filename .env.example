# ==============================================================================
# Khel Setu (खेल सेतु) - Environment Configuration
# ==============================================================================
# Copy this file to `.env` (or `.env.local` for local development overrides).
# Never commit `.env` or sensitive production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Application Settings
# ------------------------------------------------------------------------------
# The canonical public URL where the application is hosted.
# In local development: http://localhost:3000
# In production: https://khelsetu.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional JWT secret for custom signing and token verification
JWT_SECRET="generate-a-strong-64-character-hex-secret-in-production"

# ------------------------------------------------------------------------------
# 2. Authentication & User Management (Clerk)
# ------------------------------------------------------------------------------
# Retrieve these credentials from your Clerk Dashboard (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Endpoint Signing Secret)
# Used to verify user creation/update/deletion sync events
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_signing_secret"

# Clerk Application Route Redirects (App Router)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ------------------------------------------------------------------------------
# 3. Database Layer (Neon Serverless PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
# Connection string to your PostgreSQL instance.
# Neon DB Serverless pooling endpoint format:
# "postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require"
DATABASE_URL="postgresql://username:password@ep-divine-bar-example.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection URL (optional, used for Prisma migrations when using connection poolers)
# DIRECT_URL="postgresql://username:password@ep-divine-bar-example.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 4. Media Storage & Asset Delivery (Cloudinary)
# ------------------------------------------------------------------------------
# Cloudinary credentials for handling sports photo uploads, logos, and digital certificates.
# Retrieve from Cloudinary Console (https://console.cloudinary.com).
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 5. Transactional Email Service (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
# SMTP credentials for sending welcome emails, tournament registration confirmations,
# digital certificate issue notices, and sponsor invitations.
# Default shown for Gmail SMTP / Google Workspace App Password.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-16-character-app-password"
EMAIL_FROM="Khel Setu <noreply@khelsetu.com>"
